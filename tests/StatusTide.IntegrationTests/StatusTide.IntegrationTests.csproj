<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\StatusTide.Api\StatusTide.Api.csproj" />
    <!-- Every executable has a global Program class. The aliases keep the workers' out of
         the way, so Program still means the API in WebApplicationFactory<Program>. -->
    <ProjectReference Include="..\..\StatusTide.Publisher\StatusTide.Publisher.csproj" Aliases="Publisher" />
    <ProjectReference Include="..\..\StatusTide.Subscriber\StatusTide.Subscriber.csproj" Aliases="Subscriber" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
