# Copy this file to .env. Docker Compose reads it, and the k3d secret is made from it.
# These are local development values, not real secrets. .env is ignored by Git.

# Keep passwords to letters, digits and dashes: they go into connection strings and URIs.
POSTGRES_PASSWORD=statustide-dev
RABBITMQ_PASSWORD=statustide-dev

# Keys for the local S3 stand-in (SeaweedFS). Production has no keys: the EC2 IAM role grants S3 access.
LOCAL_S3_ACCESS_KEY=statustide
LOCAL_S3_SECRET_KEY=statustide-dev-secret

# Production settings, filled in once the AWS account exists. Not used locally.
# Never add AWS access keys here.
AWS_REGION=us-east-1
S3_BUCKET=statustide-example
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
SES_SENDER=alerts@example.com
CLOUDWATCH_LOG_GROUP=/statustide/example
DOMAIN=statustide.example.com
